(
  order_id STRING,
  customer_id STRING,
  product_id STRING,
  quantity_raw STRING,
  unit_price_raw STRING,
  order_ts_raw STRING,
  order_status STRING,
  source_system STRING,
  reject_reason STRING,
  batch_date DATE,
  source_file STRING,
  rejected_at TIMESTAMP
